/datum/faith/inhumen
	name = "The Ascended"
	desc = "The Holy Ecclesiarchy is a collection of sects born from the violent schism that split the Holy See in two. \n\
		The Holy Ecclesiarchy accepts the four Ascended as true divinities, proof that mortals can transcend their limits. \
		Near the seat of the Holy See, worship of the Four is considered heresy, and their followers are denounced as INHUMEN. The faithful answer such condemnation with defiance."
	worshippers = "Progressivists, cultists, and apostates of the Pantheon."
	godhead = /datum/patron/inhumen/zizo
