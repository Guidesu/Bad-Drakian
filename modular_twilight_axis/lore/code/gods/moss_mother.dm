/datum/patron/mossmother
	name = "The Mossmother"
	translated_name = "Mother of Moss"
	domain = "Swamps, decay, hidden life, witchcraft, and retribution."
	desc = "The Mossmother dwells deep within the Grimore Swamps, poised somewhere between mortal, spirit, and god. The Church of the Ten condemns her as an impostor, although even its scholars concede that she bears a flawed spark of divinity. She considers the gods' refusal to recognize her an unforgivable insult and patiently nurtures the day of her revenge."
	worshippers = "Swamp witches, outcasts, and those who make their homes in the mire."
	confess_lines = list(
		"THE MOTHER OF MOSS SEES YOU!",
		"YOU'LL PAY THE PRICE, DEAR!",
		"PSYDON'S DOGMA HAS BLINDED YOU TO THE TRUTH BEFORE YOUR EYES!",
		"RETRIBUTION IS COMING.",
		"I AM THE EARTH ITSELF. BE GRATEFUL THAT I SUFFER YOU TO WALK UPON ME.",
	)
